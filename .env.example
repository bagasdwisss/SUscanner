# Pilih salah satu konfigurasi Vision AI berikut lalu salin file ini menjadi .env.local

# Opsi 1 (Disarankan untuk lokal): Google AI Studio Gemini API Key
GEMINI_API_KEY=

# Opsional: Ganti model Gemini jika diperlukan (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Opsi 2 (Vercel AI Gateway): Gunakan AI_GATEWAY_API_KEY atau Vercel OIDC
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=google/gemini-2.5-flash
