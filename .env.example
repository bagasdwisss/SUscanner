# Pilih salah satu konfigurasi Vision AI berikut lalu salin file ini menjadi .env.local

# Opsi 1 (Disarankan untuk lokal): Google AI Studio Gemini API Key
GEMINI_API_KEY=

# Opsional: Ganti model Gemini jika diperlukan (default otomatis dengan fallback: gemini-3.5-flash -> gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.5-flash

# Opsi 2 (Vercel AI Gateway): Gunakan AI_GATEWAY_API_KEY atau Vercel OIDC
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=google/gemini-3.8-flash

# ==============================================================================
# Integrasi Google Drive & Subfolder Otomatis per Kecamatan
# ==============================================================================
# ID Folder Induk Google Drive tujuan arsip
GOOGLE_DRIVE_ROOT_FOLDER_ID=1D5fIBh9sa8cD1QBTL1J3NoRw6NWDudub

# Cara A (Paling mudah untuk Drive pribadi): Deploy Web App dari docs/google-apps-script-drive.gs
# GOOGLE_DRIVE_APPS_SCRIPT_URL=https://script.google.com/macros/s/.../exec
# GOOGLE_DRIVE_APPS_SCRIPT_SECRET=

# Cara B (Google OAuth2 Refresh Token untuk akun Gmail/Drive pribadi)
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=

# Cara C (Google Workspace Shared Drive via Service Account JSON)
# GOOGLE_SERVICE_ACCOUNT_JSON=
